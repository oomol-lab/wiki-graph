{
  "name": "wiki-graph-wikimedia",
  "version": "0.1.0",
  "description": "Wikimedia enrichment provider for Wiki Graph.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oomol-lab/wiki-graph.git"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "migrations",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rimraf dist && tsup --config tsup.config.ts"
  },
  "dependencies": {
    "pg": "^8.16.3",
    "redis": "^5.10.0",
    "wiki-graph-core": "workspace:*"
  },
  "devDependencies": {
    "@types/pg": "^8.15.6"
  }
}
