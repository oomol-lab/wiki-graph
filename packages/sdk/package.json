{
  "name": "wiki-graph-sdk",
  "version": "0.8.4",
  "description": "Node.js SDK for running Wiki Graph programmatically with local config, libraries, and jobs.",
  "keywords": [
    "wiki-graph",
    "knowledge-graph",
    "llm",
    "sdk",
    "wikg"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oomol-lab/wiki-graph.git"
  },
  "bugs": {
    "url": "https://github.com/oomol-lab/wiki-graph/issues"
  },
  "homepage": "https://github.com/oomol-lab/wiki-graph",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./archives": {
      "types": "./dist/archives.d.ts",
      "import": "./dist/archives.js",
      "require": "./dist/archives.cjs",
      "default": "./dist/archives.js"
    },
    "./default-worker": {
      "types": "./dist/default-worker.d.ts",
      "import": "./dist/default-worker.js",
      "require": "./dist/default-worker.cjs",
      "default": "./dist/default-worker.js"
    },
    "./conversions": {
      "types": "./dist/conversions.d.ts",
      "import": "./dist/conversions.js",
      "require": "./dist/conversions.cjs",
      "default": "./dist/conversions.js"
    },
    "./entry-context": {
      "types": "./dist/entry-context.d.ts",
      "import": "./dist/entry-context.js",
      "require": "./dist/entry-context.cjs",
      "default": "./dist/entry-context.js"
    },
    "./embedding": {
      "types": "./dist/embedding.d.ts",
      "import": "./dist/embedding.js",
      "require": "./dist/embedding.cjs",
      "default": "./dist/embedding.js"
    },
    "./gc": {
      "types": "./dist/gc.d.ts",
      "import": "./dist/gc.js",
      "require": "./dist/gc.cjs",
      "default": "./dist/gc.js"
    },
    "./local-config": {
      "types": "./dist/local-config.d.ts",
      "import": "./dist/local-config.js",
      "require": "./dist/local-config.cjs",
      "default": "./dist/local-config.js"
    },
    "./llm": {
      "types": "./dist/llm.d.ts",
      "import": "./dist/llm.js",
      "require": "./dist/llm.cjs",
      "default": "./dist/llm.js"
    },
    "./maintenance": {
      "types": "./dist/maintenance.d.ts",
      "import": "./dist/maintenance.js",
      "require": "./dist/maintenance.cjs",
      "default": "./dist/maintenance.js"
    },
    "./node-platform": {
      "types": "./dist/node-platform.d.ts",
      "import": "./dist/node-platform.js",
      "require": "./dist/node-platform.cjs",
      "default": "./dist/node-platform.js"
    },
    "./planning": {
      "types": "./dist/planning.d.ts",
      "import": "./dist/planning.js",
      "require": "./dist/planning.cjs",
      "default": "./dist/planning.js"
    },
    "./runtime-config": {
      "types": "./dist/runtime-config.d.ts",
      "import": "./dist/runtime-config.js",
      "require": "./dist/runtime-config.cjs",
      "default": "./dist/runtime-config.js"
    },
    "./stage": {
      "types": "./dist/stage.d.ts",
      "import": "./dist/stage.js",
      "require": "./dist/stage.cjs",
      "default": "./dist/stage.js"
    },
    "./wikispine": {
      "types": "./dist/wikispine.d.ts",
      "import": "./dist/wikispine.js",
      "require": "./dist/wikispine.cjs",
      "default": "./dist/wikispine.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js",
      "require": "./dist/worker.cjs",
      "default": "./dist/worker.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rimraf dist && tsup --config tsup.config.ts && node ../../scripts/copy-package-data.mjs ../core/data dist/data"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.68",
    "@ai-sdk/google": "^3.0.61",
    "@ai-sdk/openai": "^3.0.52",
    "@ai-sdk/openai-compatible": "^2.0.41",
    "ai": "^6.0.154",
    "nunjucks": "^3.2.4",
    "sqlite3": "^6.0.1",
    "wiki-graph-core": "workspace:*",
    "yauzl": "^3.3.0",
    "yazl": "^3.3.1",
    "zod": "^4.3.6"
  }
}
