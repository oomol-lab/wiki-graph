{
  "name": "wiki-graph-job",
  "version": "0.1.0",
  "description": "Runtime-neutral chapter build engine for Wiki Graph.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oomol-lab/wiki-graph.git"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
