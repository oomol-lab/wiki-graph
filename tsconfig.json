{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "wiki-graph-core": ["packages/core/src/index.ts"],
      "wiki-graph-core/gc": ["packages/core/src/gc.ts"],
      "wiki-graph-core/platform": ["packages/core/src/platform.ts"],
      "wiki-graph-core/worker": ["packages/core/src/worker.ts"],
      "wiki-graph-sdk": ["packages/sdk/src/index.ts"],
      "wiki-graph-sdk/archives": ["packages/sdk/src/archive/index.ts"],
      "wiki-graph-sdk/default-worker": ["packages/sdk/src/default-worker.ts"],
      "wiki-graph-sdk/conversions": ["packages/sdk/src/conversions.ts"],
      "wiki-graph-sdk/embedding": ["packages/sdk/src/embedding.ts"],
      "wiki-graph-sdk/llm": ["packages/sdk/src/llm.ts"],
      "wiki-graph-sdk/maintenance": ["packages/sdk/src/maintenance.ts"],
      "wiki-graph-sdk/runtime-config": ["packages/sdk/src/runtime-config.ts"],
      "wiki-graph-sdk/stage": ["packages/sdk/src/stage.ts"],
      "wiki-graph-sdk/entry-context": ["packages/sdk/src/entry-context.ts"],
      "wiki-graph-sdk/gc": ["packages/sdk/src/gc.ts"],
      "wiki-graph-sdk/local-config": ["packages/sdk/src/local-config.ts"],
      "wiki-graph-sdk/node-platform": ["packages/sdk/src/node-platform.ts"],
      "wiki-graph-sdk/planning": ["packages/sdk/src/planning.ts"],
      "wiki-graph-sdk/wikispine": ["packages/sdk/src/wikispine.ts"],
      "wiki-graph-sdk/worker": ["packages/sdk/src/worker.ts"],
      "wiki-graph-job": ["packages/job/src/index.ts"],
      "wiki-graph-wikimedia": ["packages/wikimedia/src/index.ts"]
    }
  },
  "include": [
    "packages/**/*.ts",
    "test/**/*.ts",
    "eslint.config.mjs",
    "packages/*/tsup.config.ts",
    "scripts/**/*.ts",
    "evals/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["packages/*/dist", "dist", "coverage", "node_modules"]
}
